<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayDock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DisplayDock">

    <Grid x:Name="Root" Background="#2C2C28" RequestedTheme="Dark">
        <Grid.Resources>
            <!-- Lightweight styling: koyu pill + mavi seçili durum -->
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#3E3E39" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#48483F" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#A9B9FF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#B9C6FF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#97A9F4" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#ECECE6" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#1C1C1A" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#1C1C1A" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#1C1C1A" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />

            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3E3E39" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#48483F" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#ECECE6" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />

            <Style x:Key="DockToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="DockButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <StackPanel x:Name="Bar"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" />
            </StackPanel.RenderTransform>

            <!-- Durum: açık ekran sayısı -->
            <Grid x:Name="StatusDot" Width="40" Height="40" ToolTipService.ToolTip="Durum">
                <Ellipse Width="24" Height="24" Fill="#4A4A44" />
                <Ellipse x:Name="StatusInner" Width="14" Height="14" Fill="#D2D2CA" />
                <TextBlock x:Name="StatusText" Text="" FontSize="10" FontWeight="SemiBold"
                           Foreground="#1C1C1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Sadece 1. ekran -->
            <ToggleButton x:Name="BtnInternal" Tag="Internal" Style="{StaticResource DockToggle}"
                          Click="OnModeClick" ToolTipService.ToolTip="Sadece 1. ekran">
                <Grid>
                    <FontIcon Glyph="&#xE7F4;" FontSize="20" />
                    <TextBlock Text="1" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                </Grid>
            </ToggleButton>

            <!-- Sadece 2. ekran -->
            <ToggleButton x:Name="BtnExternal" Tag="External" Style="{StaticResource DockToggle}"
                          Click="OnModeClick" ToolTipService.ToolTip="Sadece 2. ekran">
                <Grid>
                    <FontIcon Glyph="&#xE7F4;" FontSize="20" />
                    <TextBlock Text="2" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                </Grid>
            </ToggleButton>

            <!-- İkisi de açık (Genişlet) -->
            <ToggleButton x:Name="BtnExtend" Tag="Extend" Style="{StaticResource DockToggle}"
                          Click="OnModeClick" ToolTipService.ToolTip="İki ekran da açık (Genişlet)">
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                    <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                </StackPanel>
            </ToggleButton>

            <!-- Çoğalt -->
            <ToggleButton x:Name="BtnClone" Tag="Clone" Style="{StaticResource DockToggle}"
                          Click="OnModeClick" ToolTipService.ToolTip="Çoğalt (aynı görüntü)">
                <Grid>
                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Margin="-7,-6,0,0" Opacity="0.55" />
                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Margin="7,6,0,0" />
                </Grid>
            </ToggleButton>

            <Rectangle Width="1" Height="24" Fill="#4A4A44" Margin="4,0" VerticalAlignment="Center" />

            <!-- Uygulamayı kapat -->
            <Button Style="{StaticResource DockButton}" Click="OnExitClick"
                    ToolTipService.ToolTip="DisplayDock'u kapat">
                <FontIcon Glyph="&#xE7E8;" FontSize="18" />
            </Button>

            <!-- Sabitle -->
            <ToggleButton x:Name="BtnPin" Style="{StaticResource DockToggle}"
                          Click="OnPinClick" ToolTipService.ToolTip="Sabitle (hep görünür)">
                <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="18" />
            </ToggleButton>
        </StackPanel>
    </Grid>
</Window>
